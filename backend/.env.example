# Copy this file to `backend/.env` and fill in your values.

# --- Vertex AI (Gemini) ---
# The reasoning agent calls Gemini through Google Cloud Vertex AI. Auth uses
# Google Cloud Application Default Credentials (ADC) — NOT an API key in .env.
# Set up ADC once locally with:
#   gcloud auth application-default login
# Then ensure your account/credentials can access the project below (e.g. the
# roles/aiplatform.user role on VERTEX_PROJECT).
VERTEX_PROJECT=your_gcp_project_id_here
VERTEX_LOCATION=global

# Gemini model used by the reasoning agent. Vertex AI uses the same model names
# as the Gemini Developer API, just a different auth/endpoint path.
GEMINI_MODEL=gemini-3.5-flash

# A region is treated as "stale" when its last survey is older than this.
STALENESS_THRESHOLD_DAYS=30

# Lookback window (days) for the hospital admissions proxy signal.
ADMISSIONS_LOOKBACK_DAYS=14

# Where the latest run report is persisted. Defaults to <repo>/data/latest_report.json;
# relative paths resolve against the process working directory (run from backend/).
REPORT_FILE_PATH=../data/latest_report.json

# DataHub GMS / MCP connection used by datahub_client.py (dataset-level
# metadata reads + write-back of findings as dataset description notes).
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=your_datahub_personal_access_token_here

# Frontend origins allowed for CORS (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
