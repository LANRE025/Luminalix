# Copy this file to `backend/.env` and fill in your values.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here

# gemini-2.5-pro was fixed in the scaffold and is still operational, but it was
# deprecated in June 2026 (shutdown planned 16 Oct 2026). Official replacement:
# gemini-3.1-pro-preview. Set this once you are ready to migrate.
GEMINI_MODEL=gemini-2.5-pro

# A region is treated as "stale" when its last survey is older than this.
STALENESS_THRESHOLD_DAYS=30

# Lookback window (days) for the hospital admissions proxy signal.
ADMISSIONS_LOOKBACK_DAYS=14

# Where the latest run report is persisted. Defaults to <repo>/data/latest_report.json;
# relative paths resolve against the process working directory (run from backend/).
REPORT_FILE_PATH=../data/latest_report.json

# Frontend origins allowed for CORS (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
